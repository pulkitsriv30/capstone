# Backend URL (use http://localhost:3000 for laptop simulation, or http://<BACKEND_LAN_IP>:3000 on Raspberry Pi)
BACKEND_URL=http://localhost:3000

# Camera driver mode: pi | webcam | usb | mock
CAMERA_MODE=webcam

# Camera device identifier ('auto' for auto-discovery, or e.g. '/dev/video0' on Linux, 'Integrated Camera' on Windows)
CAMERA_DEVICE=auto

# Image optimization constraints (must stay well below backend 5MB limit)
IMAGE_MAX_WIDTH=800
IMAGE_QUALITY=75

# Camera auto-exposure warmup (ms) and capture timeout (ms)
CAMERA_WARMUP_MS=500
CAPTURE_TIMEOUT_MS=10000

# Backend HTTP timeout (ms) — must be >= 60000 due to Gemini + ElevenLabs pipeline latency
REQUEST_TIMEOUT_MS=60000

# Audio output configuration
AUDIO_PLAYER_ENABLED=true
AUDIO_PLAYER_BACKEND=auto
