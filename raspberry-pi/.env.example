# Backend URL reachable from this device (Pi and laptop must share network during development)
BACKEND_BASE_URL=http://127.0.0.1:3000

# Audio devices: leave blank to use the system default
INPUT_DEVICE=1

# Wake word model must be a trained OpenWakeWord-compatible .onnx file for "Analyse".
WAKE_WORD_MODEL=models/analyse.onnx
WAKE_WORD_THRESHOLD=0.55

# Audio capture settings
SAMPLE_RATE=16000
COMMAND_MAX_SECONDS=8
COMMAND_END_SILENCE_SECONDS=1.2
COMMAND_INITIAL_SILENCE_SECONDS=2.0
COMMAND_RMS_THRESHOLD=350

# Camera device index for laptop webcam / Pi camera configured as V4L2 device
CAMERA_INDEX=0
IMAGE_WIDTH=1280
IMAGE_JPEG_QUALITY=85

# Optional: set to 1 to run the camera/voice loop in diagnostic mode
LOG_LEVEL=INFO
